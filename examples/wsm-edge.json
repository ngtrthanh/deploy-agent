{
  "app": "wsm-edge",
  "environment": "edge-prod",
  "instance": "WHD-NC",
  "image": "ghcr.io/wsm-org/wsm-edge-server",
  "desired": {
    "source": "file",
    "path": "C:\\wsm-edge\\WHD-NC\\desired.txt"
  },
  "runtime": {
    "type": "docker-compose",
    "compose_dir": "C:\\wsm-edge\\WHD-NC",
    "compose_file": "docker-compose.yml",
    "service": "wsm-edge-server",
    "image_env": "DEPLOY_IMAGE",
    "image_env_value": "image"
  },
  "verify": {
    "url": "http://127.0.0.1:8080/healthz",
    "expected_service": "wsm-edge",
    "request_timeout_seconds": 5,
    "startup_timeout_seconds": 60,
    "retry_interval_seconds": 2
  },
  "state_file": ".deploy-agent-state.json",
  "poll_seconds": 60,
  "rollback": true,
  "agent_health": {
    "listen": "127.0.0.1:9187"
  }
}
